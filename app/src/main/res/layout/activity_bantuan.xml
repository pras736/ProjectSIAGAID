<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".BantuanActivity">

    <!-- Toolbar Bantuan Darurat -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarBantuan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_surface"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Nomor Penting Darurat"
        app:titleTextColor="@color/navy" />

    <!-- Banner Bebas Pulsa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/green_light"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_badge_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Daftar kontak darurat resmi Indonesia • Bebas Pulsa (Simple ListView)"
            android:textColor="@color/green_dark"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ListView Menggunakan Simple List Item (Kriteria Penugasan) -->
    <ListView
        android:id="@+id/listViewBantuan"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/stroke_outline"
        android:dividerHeight="1dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

</LinearLayout>
