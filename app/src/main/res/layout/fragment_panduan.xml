<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".fragment.PanduanFragment">

    <!-- Header Bar: Panduan Tindakan + Akses luring 100% tanpa internet + Search Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Panduan Tindakan"
                android:textColor="@color/navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Akses luring 100% tanpa internet"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Search Icon Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnSearchPanduan"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/card_surface"
            app:cardCornerRadius="19dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/stroke_outline"
            app:strokeWidth="1dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="Cari"
                android:src="@drawable/ic_search"
                app:tint="@color/navy" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- TabLayout Kategori Panduan Tindakan (Pertemuan 10) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPanduan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@color/app_bg"
        app:tabIndicatorColor="@color/navy"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabMode="scrollable"
        app:tabGravity="start"
        app:tabSelectedTextColor="@color/navy"
        app:tabTextColor="@color/text_secondary"
        app:tabRippleColor="@color/ripple_light"
        app:tabTextAppearance="@style/TextAppearance.SiagaID.Tab">

        <!-- Tab 1: Semua (Selected) -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Semua" />

        <!-- Tab 2: P3K Medis -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="P3K Medis" />

        <!-- Tab 3: Bencana Alam -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bencana Alam" />

        <!-- Tab 4: Evakuasi -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evakuasi" />
    </com.google.android.material.tabs.TabLayout>

    <!-- RecyclerView Panduan dengan Custom Adapter (item_panduan) (Pertemuan 10) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPanduan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        tools:listitem="@layout/item_panduan" />

</LinearLayout>
