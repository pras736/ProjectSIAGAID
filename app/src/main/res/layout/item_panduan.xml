<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Icon Kategori Panduan -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconPanduan"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/red_light"
            app:cardCornerRadius="10dp">

            <TextView
                android:id="@+id/tvIconEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🚑"
                android:textSize="22sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Konten Teks -->
        <LinearLayout
            android:id="@+id/llTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="32dp"
            android:layout_toEndOf="@id/cardIconPanduan"
            android:orientation="vertical">

            <!-- Judul Panduan -->
            <TextView
                android:id="@+id/tvJudulPanduan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Judul Panduan"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Deskripsi Singkat -->
            <TextView
                android:id="@+id/tvDeskripsiPanduan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Deskripsi singkat panduan darurat"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Badge Kategori -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/navy_light"
                app:cardCornerRadius="4dp">

                <TextView
                    android:id="@+id/tvBadgeKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Kategori"
                    android:textColor="@color/navy"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Arrow Icon -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="❯"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
