<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="4dp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/stroke_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Left Colored Vertical Indicator Strip -->
        <View
            android:id="@+id/viewIndicatorStrip"
            android:layout_width="4dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_badge_red" />

        <!-- Title, Badge & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title & Category Badge Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvJudulPanduan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="RJP / CPR (Henti Jantung)" />

                <TextView
                    android:id="@+id/tvBadgeKategori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_kritis"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/red"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    tools:text="Kritis" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeskripsiPanduan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                tools:text="Kompresi dada 100-120x/mnt • Golden period 4 mnt" />
        </LinearLayout>

        <!-- Chevron Right -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="Buka"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_muted" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
